rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function ownsUser(userId) { return signedIn() && request.auth.uid == userId; }

    match /scholarships/{scholarshipId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount']) &&
        request.resource.data.applicationCount == resource.data.applicationCount + 1);
    }

    match /applications/{applicationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.applicationId == applicationId &&
        request.resource.data.status == 'IN_PROGRESS';
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status in ['IN_PROGRESS', 'SUBMITTED']);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      // A client may create its own signup profile, but cannot self-assign an
      // administrative role. Admins own role, premium, and ban changes.
      allow create: if ownsUser(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isAdmin() || (ownsUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'suspended', 'premium', 'premiumUpdatedAt',
          'subscriptionStatus', 'subscriptionPlan', 'subscriptionStart',
          'subscriptionExpiry', 'paymentGateway', 'lastPaymentId',
          'lastTransactionId'
        ]));
      allow delete: if isAdmin();

      match /applications/{applicationId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read, write: if subcollection != 'applications' && (ownsUser(userId) || isAdmin());
      }
    }

    // Reference Points — public directory of professors, researchers,
    // labs and universities. Read-only for signed-in users, admin-only writes.
    match /reference_points/{referencePointId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Mentor Marketplace — paid mentor profiles, packages, bookings, reviews.
    // Public read for the directory pages; writes scoped to admins or to the
    // owning student/mentor (see nested match blocks).
    match /mentors_marketplace/{mentorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /mentor_packages/{packageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /mentor_bookings/{bookingId} {
      // MentorBooking.toMap() writes `userId` (the student who created the
      // booking) and `mentorId` (the mentor being booked). Accept the legacy
      // `studentId` field too so older documents keep working.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.mentorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        ));
      allow delete: if isAdmin();
    }
    match /mentor_reviews/{reviewId} {
      // MentorReview.toMap() writes `userId` (the student who submitted the
      // review). Accept the legacy `studentId` field too for older documents.
      allow read: if signedIn();
      allow create: if signedIn() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        ));
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /activity_logs/{logId} { allow read, write: if isAdmin(); }
  }
}
